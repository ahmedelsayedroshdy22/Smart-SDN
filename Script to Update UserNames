# =====================================================
# AudioCodes SBC - Create User via REST API
# =====================================================

# ----------------------------
# User Variables
# ----------------------------

$IP = "192.168.219.128"

$ApiUser     = "Admin"
$ApiPassword = "Admin"

$NewUsername = "maie"
$NewPassword = "12345"

# ----------------------------
# Authentication
# ----------------------------

$cred = "$ApiUser`:$ApiPassword"
$cred_encoded = [Convert]::ToBase64String(
    [Text.Encoding]::ASCII.GetBytes($cred)
)

# ----------------------------
# Logging
# ----------------------------

$Timestamp = Get-Date -Format "yyyyMMdd_HHmmss"

$LogFolder = ".\Logs"
New-Item -ItemType Directory -Path $LogFolder -Force | Out-Null

$LogFile = "$LogFolder\$($IP)_$Timestamp.log"

# ----------------------------
# Build CLI Script
# ----------------------------

$cliScript = @"
configure system
user $NewUsername
privilege Monitor
status valid
password-age 0
password $NewPassword
exit
"@

$CliFile = "$env:TEMP\AudioCodes_User.cli"
$cliScript | Set-Content -Path $CliFile -Encoding Ascii

Write-Host ""
Write-Host "==================================" -ForegroundColor Cyan
Write-Host " AudioCodes User Creation Process "
Write-Host "==================================" -ForegroundColor Cyan
Write-Host ""

Write-Host "Target Device : $IP"
Write-Host "Username      : $NewUsername"
Write-Host ""

try {

    # -------------------------------------
    # Create User
    # -------------------------------------

    Write-Host "Creating user..." -ForegroundColor Yellow

    $CreateResponse = .\curl.exe `
        -s `
        -k `
        -X PUT `
        "http://$IP/api/v1/files/cliScript/incremental" `
        -H "Authorization: Basic $cred_encoded" `
        -F "file=@$CliFile;type=application/octet-stream"

    Write-Host "User creation completed." -ForegroundColor Green

    # -------------------------------------
    # Save Configuration
    # -------------------------------------

    Write-Host "Saving configuration..." -ForegroundColor Yellow

    $SaveResponse = .\curl.exe `
        -s `
        -k `
        -X POST `
        "http://$IP/api/v1/actions/saveConfiguration" `
        -H "Authorization: Basic $cred_encoded" `
        -H "Content-Type: application/json" `
        -d "{}"

    Write-Host "Configuration save completed." -ForegroundColor Green

    # -------------------------------------
    # Write Log File
    # -------------------------------------

    @"
====================================================
Execution Time : $(Get-Date)
Target Device  : $IP
Username       : $NewUsername
====================================================

-----------------------------
CREATE USER RESPONSE
-----------------------------
$CreateResponse

-----------------------------
SAVE CONFIG RESPONSE
-----------------------------
$SaveResponse

====================================================
"@ | Out-File $LogFile

    Write-Host ""
    Write-Host "Success" -ForegroundColor Green
    Write-Host "Log File : $LogFile" -ForegroundColor Cyan

}
catch {

    $_ | Out-File $LogFile

    Write-Host ""
    Write-Host "FAILED" -ForegroundColor Red
    Write-Host $_.Exception.Message
}
